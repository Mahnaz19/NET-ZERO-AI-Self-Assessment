# Copy this file to ".env.production" and set real values before production deployment.

# App environment
ENVIRONMENT=production
RAG_PROVIDER=auto

# Data services
POSTGRES_USER=app
POSTGRES_PASSWORD=change_me
POSTGRES_DB=netzero
DATABASE_URL=postgresql://app:change_me@db:5432/netzero
REDIS_URL=redis://redis:6379/0

# Frontend runtime
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_USE_MOCK_BACKEND=false
USE_MOCK_BACKEND=false

# Azure OpenAI (optional, needed for Azure LLM provider)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
